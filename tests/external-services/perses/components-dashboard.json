{
  "kind": "Dashboard",
  "metadata": {
    "name": "enmaas-components",
    "project": "praxis"
  },
  "spec": {
    "display": {
      "name": "enMAAS \u2014 component resources"
    },
    "duration": "2h",
    "refreshInterval": "15s",
    "links": [
      {
        "name": "Main monitoring",
        "url": "/projects/praxis/dashboards/enmaas-monitoring",
        "targetBlank": false
      },
      {
        "name": "Gateway traffic",
        "url": "/projects/praxis/dashboards/enmaas-gateway",
        "targetBlank": false
      },
      {
        "name": "Host resources",
        "url": "/projects/praxis/dashboards/enmaas-host",
        "targetBlank": false
      },
      {
        "name": "Database & usage metering",
        "url": "/projects/praxis/dashboards/enmaas-accounting",
        "targetBlank": false
      },
      {
        "name": "Components",
        "url": "/projects/praxis/dashboards/enmaas-components",
        "targetBlank": false
      },
      {
        "name": "Traces",
        "url": "/projects/praxis/dashboards/enmaas-traces",
        "targetBlank": false
      },
      {
        "name": "Service events",
        "url": "/projects/praxis/dashboards/enmaas-logs",
        "targetBlank": false
      }
    ],
    "panels": {
      "navigation": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Monitoring navigation"
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "[Main monitoring](/projects/praxis/dashboards/enmaas-monitoring) \u00b7 [Benchmark](/projects/praxis/dashboards/enmaas-benchmark) \u00b7 [Gateway traffic](/projects/praxis/dashboards/enmaas-gateway) \u00b7 [Host](/projects/praxis/dashboards/enmaas-host) \u00b7 [Components](/projects/praxis/dashboards/enmaas-components) \u00b7 [Database & usage metering](/projects/praxis/dashboards/enmaas-accounting) \u00b7 [Alerts](/projects/praxis/dashboards/enmaas-alerts) \u00b7 [Inference traces](/projects/praxis/dashboards/enmaas-traces) \u00b7 [Service events](/projects/praxis/dashboards/enmaas-logs)\n\nInstance **All** includes historical samples without instance labels. Selecting an instance shows only samples carrying that label."
            }
          }
        }
      },
      "cpu": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Service CPU \u2014 cores",
            "description": "MEANING\nCPU seconds per second, per host and service. No CPU limit is inferred.\n\nTIME WINDOW\nMeasurements over the selected time window; gaps mean no matching samples."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "right",
                "size": "medium",
                "values": [
                  "max"
                ]
              },
              "visual": {
                "areaOpacity": 0,
                "lineWidth": 2
              },
              "yAxis": {
                "format": {
                  "unit": "decimal",
                  "decimalPlaces": 2,
                  "shortValues": true
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "rate(enmaas_container_cpu_seconds_total{host=~\"$host\",component=~\"$component\",replica=~\"$replica\"}[2m])",
                    "instant": false,
                    "seriesNameFormat": "Host: {{host}} \u00b7 Service: {{component}} \u00b7 Instance: {{replica}}"
                  }
                }
              }
            }
          ],
          "links": [
            {
              "name": "Details",
              "url": "/projects/praxis/dashboards/enmaas-components",
              "targetBlank": false
            }
          ]
        }
      },
      "memory": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Component memory",
            "description": "MEANING\nPodman-reported memory in MiB/GiB; may include reclaimable cache. Not host available memory.\n\nTIME WINDOW\nMeasurements over the selected time window; gaps mean no matching samples."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "right",
                "size": "medium",
                "values": [
                  "max"
                ]
              },
              "visual": {
                "areaOpacity": 0,
                "lineWidth": 2
              },
              "yAxis": {
                "format": {
                  "unit": "bytes",
                  "decimalPlaces": 2,
                  "shortValues": true
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "enmaas_container_memory_bytes{host=~\"$host\",component=~\"$component\",replica=~\"$replica\"}",
                    "instant": false,
                    "seriesNameFormat": "Host: {{host}} \u00b7 Service: {{component}} \u00b7 Instance: {{replica}}"
                  }
                }
              }
            }
          ],
          "links": [
            {
              "name": "Details",
              "url": "/projects/praxis/dashboards/enmaas-components",
              "targetBlank": false
            }
          ]
        }
      },
      "memorylimit": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Container memory limits",
            "description": "MEANING\nConfigured memory ceiling for each container, scaled to MiB/GiB.\n\nTIME WINDOW\nMeasurements over the selected time window; gaps mean no matching samples."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "right",
                "size": "medium",
                "values": [
                  "max"
                ]
              },
              "visual": {
                "areaOpacity": 0,
                "lineWidth": 2
              },
              "yAxis": {
                "format": {
                  "unit": "bytes",
                  "decimalPlaces": 2,
                  "shortValues": true
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "enmaas_container_memory_limit_bytes{host=~\"$host\",component=~\"$component\",replica=~\"$replica\"}",
                    "instant": false,
                    "seriesNameFormat": "Host: {{host}} \u00b7 Service: {{component}} \u00b7 Instance: {{replica}}"
                  }
                }
              }
            }
          ],
          "links": [
            {
              "name": "Details",
              "url": "/projects/praxis/dashboards/enmaas-components",
              "targetBlank": false
            }
          ]
        }
      },
      "limits": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Memory limit utilization",
            "description": "MEANING\nUsage divided by each container\u2019s own memory limit. Do not sum these percentages.\n\nTIME WINDOW\nMeasurements over the selected time window; gaps mean no matching samples."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "right",
                "size": "medium",
                "values": [
                  "max"
                ]
              },
              "visual": {
                "areaOpacity": 0,
                "lineWidth": 2
              },
              "yAxis": {
                "format": {
                  "unit": "percent",
                  "decimalPlaces": 2
                },
                "min": 0,
                "max": 100
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "100 * enmaas_container_memory_bytes{host=~\"$host\",component=~\"$component\",replica=~\"$replica\"} / (enmaas_container_memory_limit_bytes{host=~\"$host\",component=~\"$component\",replica=~\"$replica\"} > 0)",
                    "instant": false,
                    "seriesNameFormat": "Host: {{host}} \u00b7 Service: {{component}} \u00b7 Instance: {{replica}}"
                  }
                }
              }
            }
          ],
          "links": [
            {
              "name": "Details",
              "url": "/projects/praxis/dashboards/enmaas-components",
              "targetBlank": false
            }
          ]
        }
      },
      "pids": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Component processes and threads",
            "description": "MEANING\nCurrent processes and threads in each container.\n\nTIME WINDOW\nMeasurements over the selected time window; gaps mean no matching samples."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "right",
                "size": "medium",
                "values": [
                  "max"
                ]
              },
              "visual": {
                "areaOpacity": 0,
                "lineWidth": 2
              },
              "yAxis": {
                "format": {
                  "unit": "decimal",
                  "decimalPlaces": 2,
                  "shortValues": true
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "enmaas_container_pids{host=~\"$host\",component=~\"$component\",replica=~\"$replica\"}",
                    "instant": false,
                    "seriesNameFormat": "Host: {{host}} \u00b7 Service: {{component}} \u00b7 Instance: {{replica}}"
                  }
                }
              }
            }
          ],
          "links": [
            {
              "name": "Details",
              "url": "/projects/praxis/dashboards/enmaas-components",
              "targetBlank": false
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 24,
              "height": 3,
              "content": {
                "$ref": "#/spec/panels/navigation"
              }
            },
            {
              "x": 0,
              "y": 3,
              "width": 24,
              "height": 10,
              "content": {
                "$ref": "#/spec/panels/cpu"
              }
            },
            {
              "x": 0,
              "y": 13,
              "width": 24,
              "height": 10,
              "content": {
                "$ref": "#/spec/panels/memory"
              }
            },
            {
              "x": 0,
              "y": 23,
              "width": 24,
              "height": 10,
              "content": {
                "$ref": "#/spec/panels/memorylimit"
              }
            },
            {
              "x": 0,
              "y": 33,
              "width": 24,
              "height": 10,
              "content": {
                "$ref": "#/spec/panels/limits"
              }
            },
            {
              "x": 0,
              "y": 43,
              "width": 24,
              "height": 10,
              "content": {
                "$ref": "#/spec/panels/pids"
              }
            }
          ]
        }
      }
    ],
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "name": "host",
          "display": {
            "name": "Host"
          },
          "allowMultiple": true,
          "allowAllValue": true,
          "defaultValue": "$__all",
          "plugin": {
            "kind": "PrometheusLabelValuesVariable",
            "spec": {
              "labelName": "host",
              "matchers": [
                "enmaas_host_sample_unixtime_seconds{host!=\"\"}"
              ]
            }
          }
        }
      },
      {
        "kind": "ListVariable",
        "spec": {
          "name": "component",
          "display": {
            "name": "Service"
          },
          "allowMultiple": true,
          "allowAllValue": true,
          "defaultValue": "$__all",
          "plugin": {
            "kind": "PrometheusLabelValuesVariable",
            "spec": {
              "labelName": "component",
              "matchers": [
                "enmaas_container_memory_bytes{host=~\"$host\"}"
              ]
            }
          }
        }
      },
      {
        "kind": "ListVariable",
        "spec": {
          "name": "replica",
          "display": {
            "name": "Instance"
          },
          "allowMultiple": true,
          "allowAllValue": true,
          "defaultValue": "$__all",
          "plugin": {
            "kind": "PrometheusLabelValuesVariable",
            "spec": {
              "labelName": "replica",
              "matchers": [
                "enmaas_container_memory_bytes{host=~\"$host\",component=~\"$component\"}"
              ]
            }
          },
          "customAllValue": ".*"
        }
      }
    ]
  }
}
