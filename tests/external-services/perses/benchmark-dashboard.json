{
  "kind": "Dashboard",
  "metadata": {
    "name": "enmaas-benchmark",
    "project": "praxis"
  },
  "spec": {
    "display": {
      "name": "enMAAS \u2014 benchmark results"
    },
    "duration": "2h",
    "refreshInterval": "15s",
    "links": [
      {
        "name": "Main monitoring",
        "url": "/projects/praxis/dashboards/enmaas-monitoring",
        "targetBlank": false
      },
      {
        "name": "Gateway traffic",
        "url": "/projects/praxis/dashboards/enmaas-gateway",
        "targetBlank": false
      },
      {
        "name": "Host resources",
        "url": "/projects/praxis/dashboards/enmaas-host",
        "targetBlank": false
      },
      {
        "name": "Database & usage metering",
        "url": "/projects/praxis/dashboards/enmaas-accounting",
        "targetBlank": false
      },
      {
        "name": "Components",
        "url": "/projects/praxis/dashboards/enmaas-components",
        "targetBlank": false
      },
      {
        "name": "Traces",
        "url": "/projects/praxis/dashboards/enmaas-traces",
        "targetBlank": false
      },
      {
        "name": "Service events",
        "url": "/projects/praxis/dashboards/enmaas-logs",
        "targetBlank": false
      }
    ],
    "panels": {
      "navigation": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Monitoring navigation"
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "[Main monitoring](/projects/praxis/dashboards/enmaas-monitoring) \u00b7 [Benchmark](/projects/praxis/dashboards/enmaas-benchmark) \u00b7 [Gateway traffic](/projects/praxis/dashboards/enmaas-gateway) \u00b7 [Host](/projects/praxis/dashboards/enmaas-host) \u00b7 [Components](/projects/praxis/dashboards/enmaas-components) \u00b7 [Database & usage metering](/projects/praxis/dashboards/enmaas-accounting) \u00b7 [Alerts](/projects/praxis/dashboards/enmaas-alerts) \u00b7 [Inference traces](/projects/praxis/dashboards/enmaas-traces) \u00b7 [Service events](/projects/praxis/dashboards/enmaas-logs)"
            }
          }
        }
      },
      "intro": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Benchmark"
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "Select the run\u2019s time window. Cards show the selected point in its phase; charts show the full progression. Offered traffic is not achieved throughput. The run report verifies stored usage and cleanup. [Host and gateway resources](/projects/praxis/dashboards/enmaas-monitoring)"
            }
          }
        }
      },
      "generatordispatched": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Generator dispatch rate",
            "description": "MEANING\nAverage dispatched requests per second since this phase began. Includes in-flight requests.\n\nTime: selected dashboard end time. Missing or stale data is unavailable, not zero.\n\nTIME WINDOW\nSnapshot at the selected end time."
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "requests/sec",
                "decimalPlaces": 1
              },
              "thresholds": {
                "mode": "absolute",
                "defaultColor": "#52606d",
                "steps": []
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "(enmaas_stress_dispatched / clamp_min(enmaas_stress_elapsed_seconds, 1)) and on() (time() - max(enmaas_stress_sample_unixtime_seconds) < 30)",
                    "instant": true,
                    "seriesNameFormat": "Generator dispatch rate"
                  }
                }
              }
            }
          ],
          "links": [
            {
              "name": "Benchmark details",
              "url": "/projects/praxis/dashboards/enmaas-benchmark",
              "targetBlank": false
            }
          ]
        }
      },
      "streamsuccess": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Successful requests",
            "description": "MEANING\nPhase-average HTTP 200 completions. Distinct from dispatch and all-status completion rates.\n\nTime: selected dashboard end time. Missing or stale data is unavailable, not zero.\n\nTIME WINDOW\nSnapshot at the selected end time."
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "requests/sec",
                "decimalPlaces": 1
              },
              "thresholds": {
                "mode": "absolute",
                "defaultColor": "#52606d",
                "steps": []
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "(enmaas_stress_successful / clamp_min(enmaas_stress_elapsed_seconds, 1)) and on() (time() - max(enmaas_stress_sample_unixtime_seconds) < 30)",
                    "instant": true,
                    "seriesNameFormat": "Successful requests"
                  }
                }
              }
            }
          ],
          "links": [
            {
              "name": "Benchmark details",
              "url": "/projects/praxis/dashboards/enmaas-benchmark",
              "targetBlank": false
            }
          ]
        }
      },
      "currentgenerator": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Generator concurrency",
            "description": "MEANING\nAsync stress runner only: active requests divided by its configured cap. Warning 80%, critical 95%. This is a generator ceiling, not gateway capacity.\n\nTime: selected dashboard end time. Missing or stale data is unavailable, not zero.\n\nColors: green below warning; orange at warning; red at critical. Alert rules may require a sustained duration.\n\nTIME WINDOW\nSnapshot at the selected end time."
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "percent",
                "decimalPlaces": 1
              },
              "thresholds": {
                "mode": "absolute",
                "defaultColor": "#52606d",
                "steps": [
                  {
                    "value": 0,
                    "color": "#2e7d32"
                  },
                  {
                    "value": 80,
                    "color": "#ed6c02"
                  },
                  {
                    "value": 95,
                    "color": "#d32f2f"
                  }
                ]
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "(100 * enmaas_stress_active_requests / enmaas_stress_concurrency_limit) and on() (time() - max(enmaas_stress_sample_unixtime_seconds) < 30)",
                    "instant": true,
                    "seriesNameFormat": "Generator concurrency"
                  }
                }
              }
            }
          ],
          "links": [
            {
              "name": "Benchmark details",
              "url": "/projects/praxis/dashboards/enmaas-benchmark",
              "targetBlank": false
            }
          ]
        }
      },
      "currentgeneratorskips": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Generator skipped admissions",
            "description": "MEANING\nAsync stress runner only: offered admissions skipped because of concurrency or scheduler limits, as a percentage of this phase\u2019s offered slots. Warning 1%, critical 10%. These requests never reached the gateway.\n\nTime: selected dashboard end time. Missing or stale data is unavailable, not zero.\n\nColors: green below warning; orange at warning; red at critical. Alert rules may require a sustained duration.\n\nTIME WINDOW\nSnapshot at the selected end time."
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "percent",
                "decimalPlaces": 1
              },
              "thresholds": {
                "mode": "absolute",
                "defaultColor": "#52606d",
                "steps": [
                  {
                    "value": 0,
                    "color": "#2e7d32"
                  },
                  {
                    "value": 1,
                    "color": "#ed6c02"
                  },
                  {
                    "value": 10,
                    "color": "#d32f2f"
                  }
                ]
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "(100 * (enmaas_stress_skipped_concurrency + enmaas_stress_skipped_scheduler) / enmaas_stress_offered_slots) and on() (time() - max(enmaas_stress_sample_unixtime_seconds) < 30)",
                    "instant": true,
                    "seriesNameFormat": "Generator skipped admissions"
                  }
                }
              }
            }
          ],
          "links": [
            {
              "name": "Benchmark details",
              "url": "/projects/praxis/dashboards/enmaas-benchmark",
              "targetBlank": false
            }
          ]
        }
      },
      "rates": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Offered, dispatched and successful traffic",
            "description": "MEANING\nOffered target versus phase-average dispatch and successful completion rates. Long streams complete after admission; drain time is included in the averages.\n\nTIME WINDOW\nMeasurements over the selected time window; gaps mean no matching samples."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
                  "max"
                ]
              },
              "visual": {
                "areaOpacity": 0,
                "lineWidth": 2
              },
              "yAxis": {
                "format": {
                  "unit": "requests/sec",
                  "decimalPlaces": 2
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "enmaas_benchmark_offered_rps",
                    "instant": false,
                    "seriesNameFormat": "Offered target"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "enmaas_stress_dispatched / clamp_min(enmaas_stress_elapsed_seconds, 1)",
                    "seriesNameFormat": "Dispatched"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "enmaas_stress_successful / clamp_min(enmaas_stress_elapsed_seconds, 1)",
                    "seriesNameFormat": "HTTP 200 completed"
                  }
                }
              }
            }
          ],
          "links": [
            {
              "name": "Details",
              "url": "/projects/praxis/dashboards/enmaas-benchmark",
              "targetBlank": false
            }
          ]
        }
      },
      "population": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Human and bot workload equivalents"
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "Two alternative demand models, not observed identities or supported seat counts. **People:** one model request per minute per active person. **Bots:** ten model requests per minute per active bot. Each chart compares the offered target with achieved dispatch. Do not add the two estimates: each assumes all traffic comes from that category. A real mix depends on measured request frequency and the human/bot traffic split."
            }
          }
        }
      },
      "people": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Expected active people \u2014 1 request/minute",
            "description": "MEANING\nAlternative all-people demand estimate assuming one request per minute per active person; not observed users or a capacity guarantee. Offered target and achieved dispatch are multiplied by the assumed interval. Dispatch is averaged from phase start, including stream drain. Do not add this to the other population estimate.\n\nTIME WINDOW\nMeasurements over the selected time window; gaps mean no matching samples."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
                  "max"
                ]
              },
              "visual": {
                "areaOpacity": 0,
                "lineWidth": 2
              },
              "yAxis": {
                "format": {
                  "unit": "decimal",
                  "decimalPlaces": 2,
                  "shortValues": true
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "60 * enmaas_benchmark_offered_rps",
                    "instant": false,
                    "seriesNameFormat": "Offered workload equivalent"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "60 * enmaas_stress_dispatched / clamp_min(enmaas_stress_elapsed_seconds, 1)",
                    "seriesNameFormat": "Dispatched workload equivalent"
                  }
                }
              }
            }
          ],
          "links": [
            {
              "name": "Details",
              "url": "/projects/praxis/dashboards/enmaas-benchmark",
              "targetBlank": false
            }
          ]
        }
      },
      "bots": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Expected active bots \u2014 10 requests/minute",
            "description": "MEANING\nAlternative all-bots demand estimate assuming ten requests per minute per active bot; not observed users or a capacity guarantee. Offered target and achieved dispatch are multiplied by the assumed interval. Dispatch is averaged from phase start, including stream drain. Do not add this to the other population estimate.\n\nTIME WINDOW\nMeasurements over the selected time window; gaps mean no matching samples."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
                  "max"
                ]
              },
              "visual": {
                "areaOpacity": 0,
                "lineWidth": 2
              },
              "yAxis": {
                "format": {
                  "unit": "decimal",
                  "decimalPlaces": 2,
                  "shortValues": true
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "6 * enmaas_benchmark_offered_rps",
                    "instant": false,
                    "seriesNameFormat": "Offered workload equivalent"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "6 * enmaas_stress_dispatched / clamp_min(enmaas_stress_elapsed_seconds, 1)",
                    "seriesNameFormat": "Dispatched workload equivalent"
                  }
                }
              }
            }
          ],
          "links": [
            {
              "name": "Details",
              "url": "/projects/praxis/dashboards/enmaas-benchmark",
              "targetBlank": false
            }
          ]
        }
      },
      "concurrency": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Active requests and generator capacity",
            "description": "MEANING\nActive generator requests; the configured ceiling is a generator constraint, not gateway capacity.\n\nTIME WINDOW\nMeasurements over the selected time window; gaps mean no matching samples."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
                  "max"
                ]
              },
              "visual": {
                "areaOpacity": 0,
                "lineWidth": 2
              },
              "yAxis": {
                "format": {
                  "unit": "decimal",
                  "decimalPlaces": 2,
                  "shortValues": true
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "enmaas_stress_active_requests",
                    "instant": false,
                    "seriesNameFormat": "Active requests and generator capacity"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "enmaas_stress_concurrency_limit",
                    "seriesNameFormat": "Configured ceiling"
                  }
                }
              }
            }
          ],
          "links": [
            {
              "name": "Details",
              "url": "/projects/praxis/dashboards/enmaas-benchmark",
              "targetBlank": false
            }
          ]
        }
      },
      "skips": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Admissions skipped",
            "description": "MEANING\nPer-phase admissions not dispatched because of concurrency or scheduler limits.\n\nTIME WINDOW\nMeasurements over the selected time window; gaps mean no matching samples."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
                  "max"
                ]
              },
              "visual": {
                "areaOpacity": 0,
                "lineWidth": 2
              },
              "yAxis": {
                "format": {
                  "unit": "decimal",
                  "decimalPlaces": 2,
                  "shortValues": true
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "enmaas_stress_skipped_concurrency + enmaas_stress_skipped_scheduler",
                    "instant": false,
                    "seriesNameFormat": "Admissions skipped"
                  }
                }
              }
            }
          ],
          "links": [
            {
              "name": "Details",
              "url": "/projects/praxis/dashboards/enmaas-benchmark",
              "targetBlank": false
            }
          ]
        }
      },
      "failures": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Completed requests without HTTP 200",
            "description": "MEANING\nPer-phase non-success outcomes. Consult the report for status and transport-error breakdown.\n\nTIME WINDOW\nMeasurements over the selected time window; gaps mean no matching samples."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
                  "max"
                ]
              },
              "visual": {
                "areaOpacity": 0,
                "lineWidth": 2
              },
              "yAxis": {
                "format": {
                  "unit": "decimal",
                  "decimalPlaces": 2,
                  "shortValues": true
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "enmaas_stress_completed - enmaas_stress_successful",
                    "instant": false,
                    "seriesNameFormat": "Completed requests without HTTP 200"
                  }
                }
              }
            }
          ],
          "links": [
            {
              "name": "Details",
              "url": "/projects/praxis/dashboards/enmaas-benchmark",
              "targetBlank": false
            }
          ]
        }
      },
      "phase": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Load stages",
            "description": "MEANING\nOne active phase at a time; zero is inactive. Stage changes reset generator phase counters.\n\nTIME WINDOW\nMeasurements over the selected time window; gaps mean no matching samples."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
                  "max"
                ]
              },
              "visual": {
                "areaOpacity": 0,
                "lineWidth": 2
              },
              "yAxis": {
                "format": {
                  "unit": "decimal",
                  "decimalPlaces": 2,
                  "shortValues": true
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "enmaas_benchmark_phase",
                    "instant": false,
                    "seriesNameFormat": "{{phase}}"
                  }
                }
              }
            }
          ],
          "links": [
            {
              "name": "Details",
              "url": "/projects/praxis/dashboards/enmaas-benchmark",
              "targetBlank": false
            }
          ]
        }
      },
      "firing": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Firing benchmark alerts",
            "description": "MEANING\nGenerator warnings only. Operational alerts are in Main monitoring.\n\nTIME WINDOW\nSnapshot at the selected end time."
          },
          "plugin": {
            "kind": "Table",
            "spec": {
              "density": "standard",
              "pagination": true,
              "defaultColumnHeight": "auto",
              "columnSettings": [
                {
                  "name": "category",
                  "header": "Category",
                  "sort": "asc",
                  "width": 110
                },
                {
                  "name": "severity",
                  "header": "Severity",
                  "width": 100
                },
                {
                  "name": "summary",
                  "header": "Condition",
                  "width": 260
                },
                {
                  "name": "host",
                  "header": "Host",
                  "width": 120
                },
                {
                  "name": "component",
                  "header": "Service",
                  "width": 130
                },
                {
                  "name": "replica",
                  "header": "Instance",
                  "width": 100
                },
                {
                  "name": "action",
                  "header": "Response",
                  "width": 330
                },
                {
                  "name": "detail",
                  "header": "Details",
                  "width": 100,
                  "dataLink": {
                    "url": "/projects/praxis/dashboards/enmaas-${__data.fields[\"detail\"]}",
                    "openNewTab": false
                  }
                },
                {
                  "name": "timestamp",
                  "hide": true
                },
                {
                  "name": "value",
                  "hide": true
                },
                {
                  "name": "__name__",
                  "hide": true
                },
                {
                  "name": "alertname",
                  "hide": true
                },
                {
                  "name": "alertstate",
                  "hide": true
                },
                {
                  "name": "exported_job",
                  "hide": true
                },
                {
                  "name": "instance",
                  "hide": true
                },
                {
                  "name": "job",
                  "hide": true
                },
                {
                  "name": "otel_scope_name",
                  "hide": true
                }
              ],
              "cellSettings": [
                {
                  "condition": {
                    "kind": "Value",
                    "spec": {
                      "value": "critical"
                    }
                  },
                  "textColor": "#b71c1c"
                },
                {
                  "condition": {
                    "kind": "Value",
                    "spec": {
                      "value": "warning"
                    }
                  },
                  "textColor": "#995200"
                }
              ]
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "ALERTS{alertstate=\"firing\",category=\"generator\"}",
                    "instant": true,
                    "seriesNameFormat": "{{category}} \u00b7 {{summary}} \u2014 {{action}}"
                  }
                }
              }
            }
          ],
          "links": [
            {
              "name": "Details",
              "url": "/projects/praxis/dashboards/enmaas-benchmark",
              "targetBlank": false
            }
          ]
        }
      },
      "loadcpu": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Load versus service CPU \u2014 cores",
            "description": "MEANING\nLeft axis: CPU cores per selected host/service/instance. Right axis: achieved generator dispatch rate, averaged from phase start. The mock provider and generator can constrain throughput independently of the gateway.\n\nTIME WINDOW\nMeasurements over the selected time window; gaps mean no matching samples."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "right",
                "size": "medium",
                "values": []
              },
              "visual": {
                "areaOpacity": 0,
                "lineWidth": 2
              },
              "yAxis": {
                "format": {
                  "unit": "decimal",
                  "decimalPlaces": 2,
                  "shortValues": true
                }
              },
              "querySettings": [
                {
                  "queryIndex": 1,
                  "format": {
                    "unit": "requests/sec",
                    "decimalPlaces": 1
                  },
                  "lineStyle": "dashed"
                }
              ]
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "rate(enmaas_container_cpu_seconds_total{host=~\"$host\",component=~\"gateway-sso|metering-sso|db|provider\"}[2m])",
                    "instant": false,
                    "seriesNameFormat": "Host: {{host}} \u00b7 Service: {{component}} \u00b7 Instance: {{replica}}"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "enmaas_stress_dispatched / clamp_min(enmaas_stress_elapsed_seconds, 1)",
                    "seriesNameFormat": "Dispatched requests/s"
                  }
                }
              }
            }
          ],
          "links": [
            {
              "name": "Details",
              "url": "/projects/praxis/dashboards/enmaas-components",
              "targetBlank": false
            }
          ]
        }
      },
