      "loadpool": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Load versus database pool waiting",
            "description": "MEANING\nLeft axis: aggregate connection-pool waiting seconds per second. Concurrent waiters can make this exceed one. Right axis: achieved dispatch rate. This is application pool waiting, not PostgreSQL lock waiting.\n\nTIME WINDOW\nMeasurements over the selected time window; gaps mean no matching samples."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
