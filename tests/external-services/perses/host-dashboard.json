{
  "kind": "Dashboard",
  "metadata": {
    "name": "enmaas-host",
    "project": "praxis"
  },
  "spec": {
    "display": {
      "name": "enMAAS \u2014 host resources"
    },
    "duration": "2h",
    "refreshInterval": "15s",
    "links": [
      {
        "name": "Main monitoring",
        "url": "/projects/praxis/dashboards/enmaas-monitoring",
        "targetBlank": false
      },
      {
        "name": "Gateway traffic",
        "url": "/projects/praxis/dashboards/enmaas-gateway",
        "targetBlank": false
      },
      {
        "name": "Host resources",
        "url": "/projects/praxis/dashboards/enmaas-host",
        "targetBlank": false
      },
      {
        "name": "Database & usage metering",
        "url": "/projects/praxis/dashboards/enmaas-accounting",
        "targetBlank": false
      },
      {
        "name": "Components",
        "url": "/projects/praxis/dashboards/enmaas-components",
        "targetBlank": false
      },
      {
        "name": "Traces",
        "url": "/projects/praxis/dashboards/enmaas-traces",
        "targetBlank": false
      },
      {
        "name": "Service events",
        "url": "/projects/praxis/dashboards/enmaas-logs",
        "targetBlank": false
      }
    ],
    "panels": {
      "navigation": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Monitoring navigation"
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "[Main monitoring](/projects/praxis/dashboards/enmaas-monitoring) \u00b7 [Benchmark](/projects/praxis/dashboards/enmaas-benchmark) \u00b7 [Gateway traffic](/projects/praxis/dashboards/enmaas-gateway) \u00b7 [Host](/projects/praxis/dashboards/enmaas-host) \u00b7 [Components](/projects/praxis/dashboards/enmaas-components) \u00b7 [Database & usage metering](/projects/praxis/dashboards/enmaas-accounting) \u00b7 [Alerts](/projects/praxis/dashboards/enmaas-alerts) \u00b7 [Inference traces](/projects/praxis/dashboards/enmaas-traces) \u00b7 [Service events](/projects/praxis/dashboards/enmaas-logs)"
            }
          }
        }
      },
      "cpu": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Host CPU busy",
            "description": "MEANING\nBusy CPU share per host. Each host has its own 100% capacity; idle and I/O wait are excluded.\n\nTIME WINDOW\nMeasurements over the selected time window; gaps mean no matching samples."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "right",
                "size": "medium",
                "values": [
                  "max"
                ]
              },
              "visual": {
                "areaOpacity": 0,
                "lineWidth": 2
              },
              "yAxis": {
                "format": {
                  "unit": "percent",
                  "decimalPlaces": 2
                },
                "min": 0,
                "max": 100
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "100 * sum by(host)(rate(enmaas_host_cpu_seconds_total{host=~\"$host\",state!~\"idle|iowait\"}[2m])) / clamp_min(sum by(host)(rate(enmaas_host_cpu_seconds_total{host=~\"$host\"}[2m])), 1e-9)",
                    "instant": false,
                    "seriesNameFormat": "{{host}}"
                  }
                }
              }
            }
          ],
          "links": [
            {
              "name": "Details",
              "url": "/projects/praxis/dashboards/enmaas-host",
              "targetBlank": false
            }
          ]
        }
      },
      "memory": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Host memory",
            "description": "MEANING\nAvailable memory includes reclaimable memory. Cached overlaps other values; do not add it to unavailable.\n\nTIME WINDOW\nMeasurements over the selected time window; gaps mean no matching samples."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "right",
                "size": "medium",
                "values": [
                  "max"
                ]
              },
              "visual": {
                "areaOpacity": 0,
                "lineWidth": 2
              },
              "yAxis": {
                "format": {
                  "unit": "bytes",
                  "decimalPlaces": 2,
                  "shortValues": true
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "enmaas_host_memory_bytes{host=~\"$host\",state=~\"total|available|unavailable|cached\"}",
                    "instant": false,
                    "seriesNameFormat": "{{host}} \u00b7 {{state}}"
                  }
                }
              }
            }
          ],
          "links": [
            {
              "name": "Details",
              "url": "/projects/praxis/dashboards/enmaas-host",
              "targetBlank": false
            }
          ]
        }
      },
      "disk": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Data filesystem",
            "description": "MEANING\nCapacity and available bytes on the sampled data filesystem, separately for each host.\n\nTIME WINDOW\nMeasurements over the selected time window; gaps mean no matching samples."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "right",
                "size": "medium",
                "values": [
                  "max"
                ]
              },
              "visual": {
                "areaOpacity": 0,
                "lineWidth": 2
              },
              "yAxis": {
                "format": {
                  "unit": "bytes",
                  "decimalPlaces": 2,
                  "shortValues": true
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "enmaas_host_disk_bytes{host=~\"$host\"}",
                    "instant": false,
                    "seriesNameFormat": "{{host}} \u00b7 {{state}}"
                  }
                }
              }
            }
          ],
          "links": [
            {
              "name": "Details",
              "url": "/projects/praxis/dashboards/enmaas-host",
              "targetBlank": false
            }
          ]
        }
      },
      "load": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Host load averages",
            "description": "MEANING\nRunnable and uninterruptible tasks over each load interval. Compare with that host\u2019s CPU count; this is not a percentage.\n\nTIME WINDOW\nMeasurements over the selected time window; gaps mean no matching samples."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "right",
                "size": "medium",
                "values": [
                  "max"
                ]
              },
              "visual": {
                "areaOpacity": 0,
                "lineWidth": 2
              },
              "yAxis": {
                "format": {
                  "unit": "decimal",
                  "decimalPlaces": 2,
                  "shortValues": true
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "enmaas_host_load{host=~\"$host\"}",
                    "instant": false,
                    "seriesNameFormat": "{{host}} \u00b7 {{state}}"
                  }
                }
              }
            }
          ],
          "links": [
            {
              "name": "Details",
              "url": "/projects/praxis/dashboards/enmaas-host",
              "targetBlank": false
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 24,
              "height": 3,
              "content": {
                "$ref": "#/spec/panels/navigation"
              }
            },
            {
              "x": 0,
              "y": 3,
              "width": 24,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/cpu"
              }
            },
            {
              "x": 0,
              "y": 11,
              "width": 24,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/memory"
              }
            },
            {
              "x": 0,
              "y": 19,
              "width": 24,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/disk"
              }
            },
            {
              "x": 0,
              "y": 27,
              "width": 24,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/load"
              }
            }
          ]
        }
      }
    ],
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "name": "host",
          "display": {
            "name": "Host"
          },
          "allowMultiple": true,
          "allowAllValue": true,
          "defaultValue": "$__all",
          "plugin": {
            "kind": "PrometheusLabelValuesVariable",
            "spec": {
              "labelName": "host",
              "matchers": [
                "enmaas_host_sample_unixtime_seconds{host!=\"\"}"
              ]
            }
          }
        }
      }
    ]
  }
}
