      "reportingcoverage": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Usage verification"
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "The pinned gateway does not consistently expose its usage-report failure counter. An absent counter is not proof of successful delivery. Compare inference completions with stored usage and require exact per-user request, token and USD reconciliation for benchmark qualification."
            }
          }
        }
      }
