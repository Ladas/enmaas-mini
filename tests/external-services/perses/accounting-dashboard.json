{
  "kind": "Dashboard",
  "metadata": {
    "name": "enmaas-accounting",
    "project": "praxis"
  },
  "spec": {
    "display": {
      "name": "enMAAS \u2014 Database & usage metering"
    },
    "duration": "2h",
    "refreshInterval": "15s",
    "links": [
      {
        "name": "Main monitoring",
        "url": "/projects/praxis/dashboards/enmaas-monitoring",
        "targetBlank": false
      },
      {
        "name": "Gateway traffic",
        "url": "/projects/praxis/dashboards/enmaas-gateway",
        "targetBlank": false
      },
      {
        "name": "Host resources",
        "url": "/projects/praxis/dashboards/enmaas-host",
        "targetBlank": false
      },
      {
        "name": "Database & usage metering",
        "url": "/projects/praxis/dashboards/enmaas-accounting",
        "targetBlank": false
      },
      {
        "name": "Components",
        "url": "/projects/praxis/dashboards/enmaas-components",
        "targetBlank": false
      },
      {
        "name": "Traces",
        "url": "/projects/praxis/dashboards/enmaas-traces",
        "targetBlank": false
      },
      {
        "name": "Service events",
        "url": "/projects/praxis/dashboards/enmaas-logs",
        "targetBlank": false
      }
    ],
    "panels": {
      "navigation": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Monitoring navigation"
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "[Main monitoring](/projects/praxis/dashboards/enmaas-monitoring) \u00b7 [Benchmark](/projects/praxis/dashboards/enmaas-benchmark) \u00b7 [Gateway traffic](/projects/praxis/dashboards/enmaas-gateway) \u00b7 [Host](/projects/praxis/dashboards/enmaas-host) \u00b7 [Components](/projects/praxis/dashboards/enmaas-components) \u00b7 [Database & usage metering](/projects/praxis/dashboards/enmaas-accounting) \u00b7 [Alerts](/projects/praxis/dashboards/enmaas-alerts) \u00b7 [Inference traces](/projects/praxis/dashboards/enmaas-traces) \u00b7 [Service events](/projects/praxis/dashboards/enmaas-logs)"
            }
          }
        }
      },
      "pool": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Database pool connections",
            "description": "MEANING\nPriceTag pool only; not every PostgreSQL connection.\n\nTIME WINDOW\nMeasurements over the selected time window; gaps mean no matching samples."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
                  "max"
                ]
              },
              "visual": {
                "areaOpacity": 0,
                "lineWidth": 2
              },
              "yAxis": {
                "format": {
                  "unit": "decimal",
                  "decimalPlaces": 2,
                  "shortValues": true
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "{__name__=~\"metering_db_pool_(open|in_use|idle)_conns\"}",
                    "instant": false,
                    "seriesNameFormat": "{{__name__}}"
                  }
                }
              }
            }
          ],
          "links": [
            {
              "name": "Details",
              "url": "/projects/praxis/dashboards/enmaas-accounting",
              "targetBlank": false
            }
          ]
        }
      },
      "wait": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Database pool wait seconds per second",
            "description": "MEANING\nAggregate wait time can exceed one second per second with multiple waiters.\n\nTIME WINDOW\nMeasurements over the selected time window; gaps mean no matching samples."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
                  "max"
                ]
              },
              "visual": {
                "areaOpacity": 0,
                "lineWidth": 2
              },
              "yAxis": {
                "format": {
                  "unit": "decimal",
                  "decimalPlaces": 2,
                  "shortValues": true
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(metering_db_pool_wait_seconds_total[2m]))",
                    "instant": false,
                    "seriesNameFormat": "Database pool wait seconds per second"
                  }
                }
              }
            }
          ],
          "links": [
            {
              "name": "Details",
              "url": "/projects/praxis/dashboards/enmaas-accounting",
              "targetBlank": false
            }
          ]
        }
      },
      "ingest": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Usage recording rate",
            "description": "MEANING\nUsage events accepted per second.\n\nTIME WINDOW\nMeasurements over the selected time window; gaps mean no matching samples."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
                  "max"
                ]
              },
              "visual": {
                "areaOpacity": 0,
                "lineWidth": 2
              },
              "yAxis": {
                "format": {
                  "unit": "events/sec",
                  "decimalPlaces": 2
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(metering_events_ingested_total[2m]))",
                    "instant": false,
                    "seriesNameFormat": "Usage recording rate"
                  }
                }
              }
            }
          ],
          "links": [
            {
              "name": "Details",
              "url": "/projects/praxis/dashboards/enmaas-accounting",
              "targetBlank": false
            }
          ]
        }
      },
      "errors": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Usage recording errors per second",
            "description": "MEANING\nFailed usage inserts per second. Any sustained failure threatens usage-record completeness.\n\nTIME WINDOW\nMeasurements over the selected time window; gaps mean no matching samples."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
                  "max"
                ]
              },
              "visual": {
                "areaOpacity": 0,
                "lineWidth": 2
              },
              "yAxis": {
                "format": {
                  "unit": "events/sec",
                  "decimalPlaces": 2
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(metering_usage_event_insert_errors_total[2m]))",
                    "instant": false,
                    "seriesNameFormat": "Usage recording errors per second"
                  }
                }
              }
            }
          ],
          "links": [
            {
              "name": "Details",
              "url": "/projects/praxis/dashboards/enmaas-accounting",
              "targetBlank": false
            }
          ]
        }
      },
      "latency": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Usage recording p95 duration",
            "description": "MEANING\n95th-percentile insert duration. Requires activity; an idle histogram is undefined.\n\nTIME WINDOW\nMeasurements over the selected time window; gaps mean no matching samples."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
                  "max"
                ]
              },
              "visual": {
                "areaOpacity": 0,
                "lineWidth": 2
              },
              "yAxis": {
                "format": {
                  "unit": "seconds",
                  "decimalPlaces": 2
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.95,sum by(le)(rate(metering_usage_event_insert_duration_seconds_bucket[2m])))",
                    "instant": false,
                    "seriesNameFormat": "Usage recording p95 duration"
                  }
                }
              }
            }
          ],
          "links": [
            {
              "name": "Details",
              "url": "/projects/praxis/dashboards/enmaas-accounting",
              "targetBlank": false
            }
          ]
        }
      },
      "quota": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Quota checks and denials",
            "description": "MEANING\nCumulative counters; budget denials are policy decisions.\n\nTIME WINDOW\nMeasurements over the selected time window; gaps mean no matching samples."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
