        "kind": "Panel",
        "spec": {
          "display": {
            "name": "PostgreSQL deadlocks",
            "description": "MEANING\nDetected deadlocks during the last two minutes; not ordinary lock waits.\n\nTIME WINDOW\nMeasurements over the selected time window; gaps mean no matching samples."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
