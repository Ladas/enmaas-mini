          ],
          "links": [
            {
              "name": "Details",
              "url": "/projects/praxis/dashboards/enmaas-accounting",
              "targetBlank": false
            }
          ]
        }
      },
      "dbconnections": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "PostgreSQL connections",
            "description": "MEANING\nConnections to the metering database. The server connection limit is shared with other databases.\n\nTIME WINDOW\nMeasurements over the selected time window; gaps mean no matching samples."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
                  "max"
