#!/usr/bin/env bash

set -euo pipefail

if [[ "${1:-}" == --help || "$#" -lt 2 ]]; then
  cat <<'EOF'
Usage: bootc/test-images IMAGE_PREFIX VARIANT...
Variants: praxis vllm-cpu vllm-gpu
EOF
  [[ "${1:-}" == --help ]] && exit 0
  exit 2
fi

prefix="$1"
shift

for variant in "$@"; do
  case "${variant}" in
    praxis|vllm-cpu|vllm-gpu) ;;
    *) printf 'unsupported variant: %s\n' "${variant}" >&2; exit 2 ;;
  esac
  image="${prefix}:${variant}"
  [[ "$(podman image inspect "${image}" --format '{{.Os}}/{{.Architecture}}')" == linux/amd64 ]] || exit 1
  podman run --rm --network=none --entrypoint /bin/bash "${image}" -euc '
    source /etc/os-release
    [[ "$ID" == rhel && "$VERSION_ID" == 9.* ]]
    test -x /usr/bin/bootc
    test -x /usr/bin/podman
    root=/usr/share/secure-single-server
    test ! -e "${root}/bootc/harness"
    test ! -e /etc/pki/rhui/content-rhel9.key
    test ! -s /etc/yum.repos.d/bootc-rhui.repo
    if [[ "$1" == praxis ]]; then
      test -f "${root}/configs/all-in-one/shared-gateway.yaml"
      test -f "${root}/configs/vllm/praxis-remote.yaml"
      test -L /etc/systemd/system/multi-user.target.wants/secure-single-server-praxis.service
      test -x /usr/bin/sss-praxis
      test ! -x /usr/bin/nvidia-smi
    else
      test -L /etc/systemd/system/multi-user.target.wants/secure-single-server-vllm.service
      test -x /usr/bin/sss-vllm
      test -f "${root}/configs/vllm/images.env"
      test "$(cat "${root}/bootc/vllm-profile")" = "${1#vllm-}"
      if [[ "$1" == vllm-gpu ]]; then
        test -x /usr/bin/nvidia-smi
        test -x /usr/bin/nvidia-ctk
      else
        test ! -x /usr/bin/nvidia-smi
        test ! -x /usr/bin/nvidia-ctk
      fi
    fi
  ' -- "${variant}"
done
